# Tensor — indexação e slicing
# Exercita .() com índices, ranges, wildcard _, e at (flatten).
# Mostra a distinção: índices completos → Result::T; eixo parcial → Tensor.

action main
    let m := [1 2 3; 4 5 6]       # Tensor 2×3

    echo!("--- elemento específico: m.(0 1) → Result ---")
    let e := m.(0 1)
    echo!(e)

    echo!("--- linha 0: m.(0) → Tensor 1×3 ---")
    let r := m.(0)
    echo!(r)

    echo!("--- coluna 1: m.(_ 1) → Tensor 2×1 ---")
    let c := m.(_ 1)
    echo!(c)

    echo!("--- sub-matriz: m.(0..2 1..3) → Tensor 2×2 ---")
    let s := m.(0..2 1..3)
    echo!(s)

    echo!("--- todas as linhas, colunas 0..2: m.(_ 0..2) → Tensor 2×2 ---")
    let s2 := m.(_ 0..2)
    echo!(s2)

    echo!("--- flatten: at m 5 → Result ---")
    let f := at m 5
    echo!(f)

main!()