# Tensor — álgebra linear canônica
# matmul, transposta, element-wise (+, *), Hadamard, scale/shift, produto escalar.
# dot e * retornam Result — desempacota com | (fallback não alcançável: shapes casam).
# dot 1D×1D retorna Tensor 1×1 (não escalar) — fallback deve ser Tensor.

action main
    let a := [1 2; 3 4]
    let b := [5 6; 7 8]

    echo!("--- matmul: dot a b ---")
    let c := dot a b | [0 0; 0 0]
    echo!(c)

    echo!("--- transposta de a (zero-copy, infalível) ---")
    let at := transpose a
    echo!(at)

    echo!("--- element-wise + (variante pânica: shapes casam) ---")
    let sum := _+ a b
    echo!(sum)

    echo!("--- Hadamard (element-wise *): a * b ---")
    let had := * a b | [0 0; 0 0]
    echo!(had)

    echo!("--- scale: a × 2 ---")
    let sc := scale a 2
    echo!(sc)

    echo!("--- shift: a + 1 ---")
    let sh := shift a 1
    echo!(sh)

    echo!("--- produto escalar 1-D ---")
    let v1 := [1 2 3;]           # 1×3
    let v2 := [4 5 6;]           # 1×3
    let dp := dot v1 v2 | [0;]   # dot 1D → Tensor 1×1
    echo!(dp)

main!()