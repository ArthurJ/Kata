# Prelude do Kata — tipos primitivos, enums, operadores.
# Carregado pelo ModuleLoader antes do módulo do usuário.

import core_internals

# ── Tipos primitivos ──────────────────────────────────────────
# @ffi mapeia para PrimTy no resolution: i64→Int, f64→Float,
# kata_rt_string→Text, kata_rt_rat→Rational.

@ffi("i64")
data Int ()

@ffi("f64")
data Float ()

@ffi("kata_rt_string")
data Text ()

@ffi("kata_rt_rat")
data Rational ()

# ── Boolean ───────────────────────────────────────────────────

enum Boolean
    True
    False

# ── Enums genéricos ───────────────────────────────────────────
# Variantes com payload Ty::Var (UPPER_CASE) são detectadas pelo
# resolution como type params → register_generic.

enum Result
    Ok(T)
    Err(E|Text)

enum Optional
    Some(T)
    None

# ── Interfaces base ───────────────────────────────────────────

interface EQ
    = :: Self Self => Boolean
    != :: Self Self => Boolean

interface ORD implements EQ
    < :: Self Self => Boolean

    > :: Self Self => Boolean

    <= :: Self Self => Boolean

    >= :: Self Self => Boolean

interface NUM implements EQ
    + :: Self Self => Self

    - :: Self Self => Self

    * :: Self Self => Self

    div :: Self Self => Result::(Self, Text)

    / :: Self NonZero => Self

    mod :: Self NonZero => Self
    lambda a b: - a (* b (/ a b))

    // :: Self NonZero => Int
    lambda a b: int (/ a b)

    zero :: Self => Self

    abs :: Self => Self

interface SHOW
    show :: Self => Text

# ── Interfaces de coleção (Fio 8) ──────────────────────────────

interface ITERABLE::A
    next :: Self => Optional::A

interface COUNTABLE
    len :: Self => Int

interface INDEXABLE::A
    at :: Self Int => Result::A

interface CONTAINS::A
    contains :: Self A => Boolean

# ── Interfaces de hash (Fio 13) ────────────────────────────────

interface HASHABLE
    hash :: Self => Int

interface STEPPABLE
    step :: Self => Self
    lambda x:
        x
    is_neutral :: Self => Boolean
    lambda x:
        false

# ── Implementações para Int ───────────────────────────────────

Int implements NUM
    @ffi("kata_rt_bi_add") @associative(0) @commutative
    + :: Int Int => Int

    @ffi("kata_rt_bi_sub")
    - :: Int Int => Int

    @ffi("kata_rt_bi_mul") @associative(1) @commutative
    * :: Int Int => Int

    div :: Int Int => Result::(Int, Text)
    lambda a b:
        = b 0: core.Result::Err "divisão por zero"
        otherwise: core.Result::Ok (bi_div a b)

    @ffi("kata_rt_bi_div")
    / :: Int NonZero => Int

    @ffi("kata_rt_bi_div")
    // :: Int NonZero => Int

    zero :: Int => Int
    lambda _: 0

    abs :: Int => Int
    lambda a:
        < a 0: - 0 a
        otherwise: a

    @ffi("kata_rt_bi_eq") @commutative
    = :: Int Int => Boolean

    @ffi("kata_rt_bi_neq") @commutative
    != :: Int Int => Boolean

Int implements ORD
    @ffi("kata_rt_bi_lt")
    < :: Int Int => Boolean

    @ffi("kata_rt_bi_gt")
    > :: Int Int => Boolean

    @ffi("kata_rt_bi_le")
    <= :: Int Int => Boolean

    @ffi("kata_rt_bi_ge")
    >= :: Int Int => Boolean

Int implements SHOW
    @ffi("kata_rt_bi_show")
    show :: Int => Text

# ── Implementações para Float ──────────────────────────────────

Float implements NUM
    @ffi("kata_rt_fadd") @commutative
    + :: Float Float => Float

    @ffi("kata_rt_fsub")
    - :: Float Float => Float

    @ffi("kata_rt_fmul") @commutative
    * :: Float Float => Float

    div :: Float Float => Result::(Float, Text)
    lambda a b:
        = b 0.0: core.Result::Err "divisão por zero"
        otherwise: core.Result::Ok (f_div a b)

    @ffi("kata_rt_fdiv")
    / :: Float NonZero => Float

    mod :: Float NonZero => Float
    lambda a b: - a (* b (float (int (/ a b))))

    # ── Cross-type: Float × Int → Float ──────────────────────────
    @commutative
    + :: Float Int => Float
    lambda f i: + f (float i)

    @commutative
    - :: Float Int => Float
    lambda f i: - f (float i)

    @commutative
    * :: Float Int => Float
    lambda f i: * f (float i)

    # ── Cross-type: Float × Int → Float (divisão) ─────────────────
    div :: Float Int => Result::(Float, Text)
    lambda f i: div f (float i)

    / :: Float NonZero::Int => Float
    lambda f i: f_div f (float (i::Int))

    mod :: Float NonZero::Int => Float
    lambda f i: - f (* (float (int (/ f i))) i)

    # ── Cross-type: Float × Rational → Float ──────────────────────
    @commutative
    + :: Float Rational => Float
    lambda f r: + f (float r)

    @commutative
    - :: Float Rational => Float
    lambda f r: - f (float r)

    @commutative
    * :: Float Rational => Float
    lambda f r: * f (float r)

    # ── Cross-type: Float × Rational → Float (divisão) ────────────
    div :: Float Rational => Result::(Float, Text)
    lambda f r: div f (float r)

    / :: Float NonZero::Rational => Float
    lambda f r: f_div f (float (r::Rational))

    mod :: Float NonZero::Rational => Float
    lambda f r: - f (* (float (int (/ f r))) r)

    // :: Float NonZero::Int => Int
    lambda f i: int (/ f i)

    // :: Float NonZero::Rational => Int
    lambda f r: int (/ f r)

    zero :: Float => Float
    lambda _: 0.0

    abs :: Float => Float
    lambda a:
        < a 0.0: - 0.0 a
        otherwise: a

    @ffi("kata_rt_fcmp_eq") @commutative
    = :: Float Float => Boolean

    @ffi("kata_rt_fcmp_neq") @commutative
    != :: Float Float => Boolean

Float implements ORD
    @ffi("kata_rt_fcmp_lt")
    < :: Float Float => Boolean

    @ffi("kata_rt_fcmp_gt")
    > :: Float Float => Boolean

    @ffi("kata_rt_fcmp_le")
    <= :: Float Float => Boolean

    @ffi("kata_rt_fcmp_ge")
    >= :: Float Float => Boolean

Float implements SHOW
    @ffi("kata_rt_float_to_text")
    show :: Float => Text

# ── Implementações para Rational ──────────────────────────────

Rational implements NUM
    @ffi("kata_rt_rat_add") @associative(0) @commutative
    + :: Rational Rational => Rational

    @ffi("kata_rt_rat_sub")
    - :: Rational Rational => Rational

    @ffi("kata_rt_rat_mul") @associative(1) @commutative
    * :: Rational Rational => Rational

    @ffi("kata_rt_rat_div")
    / :: Rational NonZero => Rational

    mod :: Rational NonZero => Rational
    lambda a b: - a (* b (rational (int (/ a b))))

    div :: Rational Rational => Result::(Rational, Text)
    lambda a b:
        = b (rational 0): core.Result::Err "divisão por zero"
        otherwise: core.Result::Ok (rat_div a b)

    # ── Cross-type: Rational × Int → Rational ────────────────────
    @commutative
    + :: Rational Int => Rational
    lambda r i: + r (rational i)

    @commutative
    - :: Rational Int => Rational
    lambda r i: - r (rational i)

    @commutative
    * :: Rational Int => Rational
    lambda r i: * r (rational i)

    # ── Cross-type: Rational × Int → Rational (divisão) ───────────
    div :: Rational Int => Result::(Rational, Text)
    lambda r i: div r (rational i)

    / :: Rational NonZero::Int => Rational
    lambda r i: rat_div r (rational (i::Int))

    mod :: Rational NonZero::Int => Rational
    lambda r i: - r (* (rational (int (/ r i))) i)

    # ── Cross-type: Rational × Float → Rational ──────────────────
    @commutative
    + :: Rational Float => Rational
    lambda r f: + r (rational f)

    @commutative
    - :: Rational Float => Rational
    lambda r f: - r (rational f)

    @commutative
    * :: Rational Float => Rational
    lambda r f: * r (rational f)

    # ── Cross-type: Rational × Float → Rational (divisão) ─────────
    div :: Rational Float => Result::(Rational, Text)
    lambda r f: div r (rational f)

    / :: Rational NonZero::Float => Rational
    lambda r f: rat_div r (rational (f::Float))

    mod :: Rational NonZero::Float => Rational
    lambda r f: - r (* (rational (int (/ r f))) f)

    // :: Rational NonZero::Int => Int
    lambda r i: int (/ r i)

    // :: Rational NonZero::Float => Int
    lambda r f: int (/ r f)

    zero :: Rational => Rational
    lambda _: rational 0

    abs :: Rational => Rational
    lambda a:
        < a (rational 0): - (rational 0) a
        otherwise: a

    @ffi("kata_rt_rat_eq") @commutative
    = :: Rational Rational => Boolean

    @ffi("kata_rt_rat_neq") @commutative
    != :: Rational Rational => Boolean

Rational implements ORD
    @ffi("kata_rt_rat_lt")
    < :: Rational Rational => Boolean

    @ffi("kata_rt_rat_gt")
    > :: Rational Rational => Boolean

    @ffi("kata_rt_rat_le")
    <= :: Rational Rational => Boolean

    @ffi("kata_rt_rat_ge")
    >= :: Rational Rational => Boolean

Rational implements SHOW
    @ffi("kata_rt_rat_show")
    show :: Rational => Text

# ── Min/max genéricos (via ORD) ────────────────────────────────

min :: A A => A
lambda a b:
    <= a b: a
    otherwise: b

max :: A A => A
lambda a b:
    >= a b: a
    otherwise: b

# ── Refined: NonZero (polimórfico sobre NUM) ──────────────────
# NonZero para Int, Float e Rational — declarado uma vez sobre NUM.
# Posicionado APÓS Int/Float/Rational implements NUM para que o
# pass0 encontre os implementores ao expandir a família.
# Predicado != _ (zero _): rejeita zero de cada tipo (0, 0.0, rational 0).
# Predicado = _ _: rejeita NaN em Float (= NaN NaN → False em IEEE 754).
# Inócuo para Int/Rational (= x x sempre True).
# Construtor falível: NonZero(3) → Ok, NonZero(0) → Err, NonZero(NaN) → Err.

data (NUM, != _ (zero _), = _ _) as NonZero

# NonZero refines NUM — delega aritmética para o tipo base de cada instância.
NonZero refines NUM

# ── Text ──────────────────────────────────────────────────────
# Text implementa SHOW: show é identidade (Text já é Text).
Text implements SHOW
    show :: Text => Text
    lambda x: x

# ── Unit ─────────────────────────────────────────────────────
# Unit implementa SHOW: show sempre retorna "()".
Unit implements SHOW
    show :: Unit => Text
    lambda _: "()"

# ── Implementações HASHABLE ───────────────────────────────────

Int implements HASHABLE
    @ffi("kata_rt_hash_int")
    hash :: Int => Int

Text implements HASHABLE
    @ffi("kata_rt_hash_text")
    hash :: Text => Int

Rational implements HASHABLE
    @ffi("kata_rt_hash_rational")
    hash :: Rational => Int

# ── Implementações STEPPABLE ──────────────────────────────────

Int implements STEPPABLE
    step :: Int => Int
    lambda x:
        1

    is_neutral :: Int => Boolean
    lambda x:
        = x 0

Float implements STEPPABLE
    step :: Float => Float
    lambda x:
        1.0

    is_neutral :: Float => Boolean
    lambda x:
        = x 0.0

# ── Coleções: implements (Fio 8 Fase 4) ────────────────────────
# List/Array/Range são tipos intrínsecos (variants de Ty), não data.
# As implementações usam @ffi para Array/List/Text e @builtin para
# Range (operações inlined pelo codegen com base no tipo concreto).

# Array implementa ITERABLE, COUNTABLE, INDEXABLE, CONTAINS
Array::A implements ITERABLE::A
    @ffi("kata_rt_array_next")
    next :: Array::A => Optional::A

Array::A implements COUNTABLE
    @ffi("kata_rt_array_len")
    len :: Array::A => Int

Array::A implements INDEXABLE::A
    @ffi("kata_rt_array_get_checked")
    at :: Array::A Int => Result::A

Array::A implements CONTAINS::A
    @ffi("kata_rt_array_contains")
    contains :: Array::A A => Boolean

# List implementa ITERABLE, COUNTABLE, INDEXABLE, CONTAINS
List::A implements ITERABLE::A
    @ffi("kata_rt_list_next")
    next :: List::A => Optional::A

List::A implements COUNTABLE
    @ffi("kata_rt_list_len")
    len :: List::A => Int

List::A implements INDEXABLE::A
    @ffi("kata_rt_list_get_checked")
    at :: List::A Int => Result::A

List::A implements CONTAINS::A
    @ffi("kata_rt_list_contains")
    contains :: List::A A => Boolean

# Range implementa ITERABLE, COUNTABLE, CONTAINS (não INDEXABLE)
# Range usa @builtin — codegen inlined com base no tipo concreto de A
Range::A implements ITERABLE::A
    @builtin("range_next")
    next :: Range::A => Optional::A

Range::A implements COUNTABLE
    @builtin("range_len")
    len :: Range::A => Int

Range::A implements CONTAINS::A
    @builtin("range_contains")
    contains :: Range::A A => Boolean

# Text implementa ITERABLE, COUNTABLE, INDEXABLE, CONTAINS
Text implements ITERABLE::Text
    @ffi("kata_rt_string_next")
    next :: Text => Optional::Text

Text implements COUNTABLE
    @ffi("kata_rt_text_len")
    len :: Text => Int

Text implements INDEXABLE::Text
    @ffi("kata_rt_text_at")
    at :: Text Int => Result::Text

Text implements CONTAINS::Text
    @ffi("kata_rt_string_contains")
    contains :: Text Text => Boolean

# ── SLICEABLE (Fio 11 / PRD-bytes Fase 3) ────────────────────────

interface SLICEABLE::A
    slice :: Self Int Int => A

# Text implementa SLICEABLE (codepoints)
Text implements SLICEABLE::Text
    @ffi("kata_rt_text_slice")
    slice :: Text Int Int => Text

# Array implementa SLICEABLE
Array::A implements SLICEABLE::A
    @ffi("kata_rt_array_slice")
    slice :: (Array::A) Int Int => (Array::A)

# List implementa SLICEABLE
List::A implements SLICEABLE::A
    @ffi("kata_rt_list_slice")
    slice :: (List::A) Int Int => (List::A)

# ── Dict (Fio 13) ───────────────────────────────────────────────

Dict::(K, V) implements ITERABLE::(K, V)
    @ffi("kata_rt_dict_next")
    next :: Dict::(K, V) => Optional::(K, V)

Dict::(K, V) implements COUNTABLE
    @ffi("kata_rt_dict_len")
    len :: Dict::(K, V) => Int

Dict::(K, V) implements INDEXABLE::V
    @ffi("kata_rt_dict_get_checked")
    at :: Dict::(K, V) K => Result::V

Dict::(K, V) implements CONTAINS::K
    @ffi("kata_rt_dict_contains")
    contains :: Dict::(K, V) K => Boolean

# ── Set (Fio 13) ────────────────────────────────────────────────

Set::T implements ITERABLE::T
    @ffi("kata_rt_set_next")
    next :: Set::T => Optional::T

Set::T implements COUNTABLE
    @ffi("kata_rt_set_len")
    len :: Set::T => Int

Set::T implements CONTAINS::T
    @ffi("kata_rt_set_contains")
    contains :: Set::T T => Boolean

# ── Operações de Set (standalone) ───────────────────────────────

@ffi("kata_rt_set_union")
union :: Set::T Set::T => Set::T

@ffi("kata_rt_set_intersection")
intersection :: Set::T Set::T => Set::T

@ffi("kata_rt_set_difference")
difference :: Set::T Set::T => Set::T

# ── Operações de Dict (standalone) ──────────────────────────────

@ffi("kata_rt_dict_insert")
insert :: Dict::(K, V) K V => Dict::(K, V)

@ffi("kata_rt_dict_remove")
remove :: Dict::(K, V) K => Dict::(K, V)

# ── Operadores + e - para Set e Dict ────────────────────────────
# Sobrecargas: o DispatchTable resolve por tipo do segundo argumento.
# Set + Set = union, Set + elem = insert, Set - Set = difference, Set - elem = remove
# Dict - key = remove

@ffi("kata_rt_set_union")
+ :: Set::T Set::T => Set::T

@ffi("kata_rt_set_insert")
+ :: Set::T T => Set::T

@ffi("kata_rt_set_difference")
- :: Set::T Set::T => Set::T

@ffi("kata_rt_set_remove")
- :: Set::T T => Set::T

@ffi("kata_rt_dict_remove")
- :: Dict::(K, V) K => Dict::(K, V)

@ffi("kata_rt_dict_merge")
+ :: Dict::(K, V) Dict::(K, V) => Dict::(K, V)

# ── Operadores standalone (não-interface) ──────────────────────

# / e mod agora são métodos da interface NUM:
# / :: Self NonZero => Self  (divisão segura)
# mod :: Self NonZero => Self (default method da interface NUM)
# Ver implementações em Int/Float/Rational implements NUM acima.
#
# Divisão unchecked (bi_div, f_div, rat_div) vem de import core_internals.
# São usadas por `div` após verificar zero em runtime.

# AND lógico (Boolean é enum True/False, sem operador nativo)
and :: Boolean Boolean => Boolean
lambda a b:
    a: b
    otherwise: False

# OR lógico — short-circuit: se a é True, retorna True sem avaliar b
or :: Boolean Boolean => Boolean
lambda a b:
    a: True
    otherwise: b

# NOT lógico — inverte Boolean
not :: Boolean => Boolean
lambda a:
    a: False
    otherwise: True

# List head/tail (extrai primeiro elemento / resto da lista)
@ffi("kata_rt_list_head")
head :: List::A => A

@ffi("kata_rt_list_tail")
tail :: List::A => List::A

# List cons (construtor: prepend elemento na lista)
@ffi("kata_rt_list_cons")
cons :: A List::A => List::A

# List concat (+ standalone — não é NUM, dispatch resolve por tipo dos args)
@ffi("kata_rt_list_concat")
+ :: List::A List::A => List::A

# ── Conversões ────────────────────────────────────────────────

@ffi("kata_rt_rat_to_float")
float :: Rational => Float

@ffi("kata_rt_rat_from_float")
rational :: Float => Rational

@ffi("kata_rt_int_to_rational")
rational :: Int => Rational

@ffi("kata_rt_int_to_float")
float :: Int => Float

# ── Sobrecargas de int e float para conversão entre tipos numéricos ──
# int recebe Float, Rational, ou Byte e converte para Int.
# float recebe Int, Rational, ou Byte e converte para Float.

# int: Float → Int (trunca em direção a zero)
@ffi("kata_rt_float_to_int")
int :: Float => Int

# int: Rational → Int (trunca em direção a zero)
@ffi("kata_rt_rational_to_int")
int :: Rational => Int

# float: Byte → Float (Byte → Int → Float, reusa conversões existentes)
float :: Byte => Float
lambda b: float (int b)

# ── I/O (Actions FFI builtin) ──────────────────────────────────

@ffi("kata_rt_print")
action _print (msg::Text) => Unit

@ffi("kata_rt_println")
action _println (msg::Text) => Unit

action echo (msg::SHOW) => Unit
    let s := show msg
    _println!(s)

@ffi("kata_rt_panic")
action panic (msg::Text) => Unit

# input! — imprime prompt e lê uma linha de stdin. Retorna Text.
# Em EOF ou erro, retorna Text vazio ("").
@ffi("kata_rt_input")
action input (prompt::Text) => Text

# ── RNG ───────────────────────────────────────────────────────
# Gera um Float aleatório no intervalo [0.0, 1.0).

@ffi("kata_rt_rand")
action rand => Float

@ffi("kata_rt_rand_int")
action rand_int (min::Int, max::Int) => Int

# ── Sleep cooperativo (CSP) ─────────────────────────────────────
# Suspende o fiber atual por N milissegundos. Cooperativo — o scheduler
# acorda o fiber quando o deadline expira (via wake_pass ou earliest_deadline).

@ffi("kata_rt_sleep")
action sleep (ms::Int) => Unit

# ── Text conversions ───────────────────────────────────────────

@ffi("kata_rt_int_to_text")
int_to_text :: Int => Text

# int — converte Text para Int. Retorna Result: Ok(n) ou Err("número inválido").
# Função pura — falha é valor (Result), não efeito colateral.
@ffi("kata_rt_try_int")
int :: Text => Result::(Int, Text)

# float — converte Text para Float. Retorna Result: Ok(f) ou Err("número inválido").
# Função pura — falha é valor (Result), não efeito colateral.
@ffi("kata_rt_try_float")
float :: Text => Result::(Float, Text)

@ffi("kata_rt_bool_to_text")
bool_to_text :: Boolean => Text

# ── Text operações ─────────────────────────────────────────────

# Text concat via + (prefix, mesmo FFI)
@ffi("kata_rt_string_concat")
+ :: Text Text => Text

@ffi("kata_rt_text_replace_first")
text_replace :: Text Text => Text

# ── Higher-order: map/filter/fold (Fio 8 Fase 8) ──────────────
# Interceptados no infer_apply — não passam pelo DispatchTable.
# A assinatura é documentação; o typeck faz dispatch por tipo concreto.

@builtin("map")
map :: (A -> B) List::A => List::B

@builtin("filter")
filter :: (A -> Boolean) List::A => List::A

@builtin("fold")
fold :: (A B -> A) A List::B => A

# ── Bytes (PRD-bytes Fase 3) ──────────────────────────────────────

# Bytes implementa INDEXABLE (acesso por índice → Result::(Byte, Text))
Bytes implements INDEXABLE::Byte
    @ffi("kata_rt_bytes_get_checked")
    at :: Bytes Int => Result::Byte

# Bytes implementa COUNTABLE
Bytes implements COUNTABLE
    @ffi("kata_rt_bytes_len")
    len :: Bytes => Int

# Bytes implementa SLICEABLE
Bytes implements SLICEABLE::Bytes
    @ffi("kata_rt_bytes_slice")
    slice :: Bytes Int Int => Bytes

# Bytes implementa EQ
Bytes implements EQ
    @ffi("kata_rt_bytes_eq")
    = :: Bytes Bytes => Boolean

    @ffi("kata_rt_bytes_neq")
    != :: Bytes Bytes => Boolean

# Bytes implementa SHOW (hex)
Bytes implements SHOW
    @ffi("kata_rt_bytes_show")
    show :: Bytes => Text

# Concatenação de Bytes (+)
@ffi("kata_rt_bytes_concat")
+ :: Bytes Bytes => Bytes

# ── Bitwise para Byte ─────────────────────────────────────────────

@ffi("kata_rt_byte_and")
and :: Byte Byte => Byte

@ffi("kata_rt_byte_or")
or :: Byte Byte => Byte

@ffi("kata_rt_byte_xor")
xor :: Byte Byte => Byte

@ffi("kata_rt_byte_not")
not :: Byte => Byte

@ffi("kata_rt_byte_shr")
>> :: Byte Int => Byte

@ffi("kata_rt_byte_shl")
<< :: Byte Int => Byte

# ── Bitwise para Bytes (elemento-a-elemento) ──────────────────────

@ffi("kata_rt_bytes_and")
and :: Bytes Bytes => Bytes

@ffi("kata_rt_bytes_or")
or :: Bytes Bytes => Bytes

@ffi("kata_rt_bytes_xor")
xor :: Bytes Bytes => Bytes

@ffi("kata_rt_bytes_not")
not :: Bytes => Bytes

# ── Conversões Byte ↔ Int ────────────────────────────────────────

@ffi("kata_rt_byte_to_int")
int :: Byte => Int

@ffi("kata_rt_int_to_byte")
byte :: Int => Byte

# ── Conversões Int → Bytes (4 bytes little-endian) ───────────────

@ffi("kata_rt_int_to_bytes")
bytes :: Int => Bytes

# ── Conversões Text ↔ Bytes ──────────────────────────────────────

@ffi("kata_rt_text_to_bytes")
bytes :: Text => Bytes

@ffi("kata_rt_bytes_to_text")
text :: Bytes => Result::(Text, Text)

# ── Encoding ─────────────────────────────────────────────────────

enum Encoding
    Utf8
    Utf16
    Latin1
    Ascii

# ── LogLevel (Fio 14 @log) ────────────────────────────────────────
# Enum fixo para níveis de telemetria. Variantes unitárias.

enum LogLevel
  Debug
  Info
  Warn
  Error

# ── log!() — Actions de telemetria (Fio 14) ──────────────────────
# Migradas de interceptação no typeck para actions normais do stdlib.
# 4 overloads despacham por aridade e tipo (DispatchTable normal).
# O nível LogLevel é convertido para tag Int via pattern matching no
# body — não há mais resolve_log_level especializado no typeck.

# Helper pura: LogLevel → tag Int
_log_tag :: LogLevel => Int
lambda LogLevel::Debug: 0
lambda LogLevel::Info: 1
lambda LogLevel::Warn: 2
lambda LogLevel::Error: 3

# FFI wrappers — cada um com a aridade correspondente a um overload.
# Passam 0 (null) nos args omitidos para que o runtime use config herdada.

@ffi("kata_rt_log_publish_default")
action _log_publish (tag::Int, msg::Text) => Unit

@ffi("kata_rt_log_publish_topic")
action _log_publish (tag::Int, msg::Text, topic::Text) => Unit

@ffi("kata_rt_log_publish_full")
action _log_publish (tag::Int, msg::Text, topic::Text, policy::Text) => Unit

# log!() — 2 args: level + msg, CSP com config herdada
action log (level::LogLevel, msg::Text) => Unit
    _log_publish!(_log_tag level, msg)

# log!() — 3 args, Text em pos 2: level + msg + topic
action log (level::LogLevel, msg::Text, topic::Text) => Unit
    _log_publish!(_log_tag level, msg, topic)

# log!() — 4 args: level + msg + topic + policy
action log (level::LogLevel, msg::Text, topic::Text, policy::Text) => Unit
    _log_publish!(_log_tag level, msg, topic, policy)

# log!() — 3 args, File em pos 2: level + msg + file (write direto)
action log (level::LogLevel, msg::Text, file::File) => Unit
    let _ := write!(file, msg)

# ── File I/O ──────────────────────────────────────────────────────
# File é um tipo intrínseco (Ty::File) — handle opaco para arquivo aberto.
# Encoding é determinado pela operação: read → Bytes, readline → Text.

enum FileMode
    Read
    Write
    Append
    ReadWrite
    Create

@ffi("kata_rt_file_open")
action open (path::Text, mode::FileMode) => Result::(File, Text)

@ffi("kata_rt_file_read")
action read (f::File) => Result::(Bytes, Text)

@ffi("kata_rt_file_read_chunk")
action read (f::File, n::Int) => Result::(Bytes, Text)

@ffi("kata_rt_file_readline")
action readline (f::File) => Result::(Text, Text)

@ffi("kata_rt_file_write_text")
action write (f::File, content::Text) => Result::(Unit, Text)

@ffi("kata_rt_file_write_bytes")
action write (f::File, content::Bytes) => Result::(Unit, Text)

@ffi("kata_rt_file_close")
action close (f::File) => Unit

# echo para file — escreve show(msg) + newline
action echo (msg::SHOW, f::File) => Unit
    let s := show msg
    let _ := write!(f, s)
    let _ := write!(f, "\n")

# ── Socket I/O ────────────────────────────────────────────────────
# Socket é um tipo intrínseco (Ty::Socket) — handle opaco para socket
# TCP ou Unix aberto. Pode ser Listener (passivo) ou Connected (ativo).

enum SocketKind
    TCP(Text)
    Unix(Text)

enum SocketMode
    Listener
    Connected

@ffi("kata_rt_socket_open")
action open (kind::SocketKind, mode::SocketMode) => Result::(Socket, Text)

@ffi("kata_rt_socket_listen")
action listen (listener::Socket) => Result::(Socket, Text)

@ffi("kata_rt_socket_read")
action read (s::Socket) => Result::(Bytes, Text)

@ffi("kata_rt_socket_read_chunk")
action read (s::Socket, n::Int) => Result::(Bytes, Text)

@ffi("kata_rt_socket_readline")
action readline (s::Socket) => Result::(Text, Text)

@ffi("kata_rt_socket_write_text")
action write (s::Socket, content::Text) => Result::(Unit, Text)

@ffi("kata_rt_socket_write_bytes")
action write (s::Socket, content::Bytes) => Result::(Unit, Text)

@ffi("kata_rt_socket_close")
action close (s::Socket) => Unit

# echo para socket — escreve show(msg) + newline
action echo (msg::SHOW, s::Socket) => Unit
    let s_val := show msg
    let _ := write!(s, s_val)
    let _ := write!(s, "\n")

# ── Hook / Target (Diretivas Customizadas) ──────────────────────────
# Enums de configuração para diretivas customizadas.
# Hook define em qual ponto do ciclo de vida a diretiva injeta.
# Target define qual tipo de item a diretiva pode decorar.

enum Hook
    Enter
    Exit
    ShortCircuit
    Transform

enum Target
    Action
    Function
    Any

# ── Diretiva trace (PRD-trace-directive Fase 2) ──────────────────────
# Diretiva de instrumentação definida em Kata no stdlib.
# Overloads despachados por (when, on, arg_keys) — cada combinação de
# args no site de aplicação seleciona a declaration correta.
#
# arg_keys = chaves do dict da declaration (excluindo when/on).
# O site @trace{msg: "...", when: "enter"} tem arg_keys=["msg"] e casa
# com a declaration que declara msg: Text no dict.
#
# Actions: 16 overloads (policy "block" disponível, file disponível).
# Funções: 8 overloads (sem policy, file disponível).
# Total: 24 declarations.

# ── log para Actions: sem file ──

directive log{when: Hook::Enter, on: Target::Action, msg: Text}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args})

directive log{when: Hook::Exit, on: Target::Action, msg: Text}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return})

directive log{when: Hook::Enter, on: Target::Action, msg: Text, topic: Text}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args}, _topic)

directive log{when: Hook::Exit, on: Target::Action, msg: Text, topic: Text}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return}, _topic)

directive log{when: Hook::Enter, on: Target::Action, msg: Text, policy: Text}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args}, "default", _policy)

directive log{when: Hook::Exit, on: Target::Action, msg: Text, policy: Text}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return}, "default", _policy)

directive log{when: Hook::Enter, on: Target::Action, msg: Text, topic: Text, policy: Text}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args}, _topic, _policy)

directive log{when: Hook::Exit, on: Target::Action, msg: Text, topic: Text, policy: Text}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return}, _topic, _policy)

# ── log para Actions: com file ──
# _file sozinho: write direto, sem CSP.

directive log{when: Hook::Enter, on: Target::Action, msg: Text, file: File}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args}, _file)

directive log{when: Hook::Exit, on: Target::Action, msg: Text, file: File}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return}, _file)

# topic + file: duas chamadas log!() — uma CSP, uma file.

directive log{when: Hook::Enter, on: Target::Action, msg: Text, topic: Text, file: File}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args}, _topic)
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args}, _file)

directive log{when: Hook::Exit, on: Target::Action, msg: Text, topic: Text, file: File}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return}, _topic)
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return}, _file)

# policy + file: CSP com policy + write direto.

directive log{when: Hook::Enter, on: Target::Action, msg: Text, policy: Text, file: File}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args}, "default", _policy)
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args}, _file)

directive log{when: Hook::Exit, on: Target::Action, msg: Text, policy: Text, file: File}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return}, "default", _policy)
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return}, _file)

# topic + policy + file: CSP com topic+policy + write direto.

directive log{when: Hook::Enter, on: Target::Action, msg: Text, topic: Text, policy: Text, file: File}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args}, _topic, _policy)
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_args": _args}, _file)

directive log{when: Hook::Exit, on: Target::Action, msg: Text, topic: Text, policy: Text, file: File}
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return}, _topic, _policy)
    log!(LogLevel::Info, format!{"_msg": _msg, "_name": _name, "_return": _return}, _file)

# ── log para Funções: sem policy, sem file ──
# Funções puras usam _log_publish! (FFI) diretamente — não podem chamar log! (action).

directive log{when: Hook::Enter, on: Target::Function, msg: Text}
    _log_publish!(_log_tag(LogLevel::Info), format!{"_msg": _msg, "_name": _name, "_args": _args})

directive log{when: Hook::Exit, on: Target::Function, msg: Text}
    _log_publish!(_log_tag(LogLevel::Info), format!{"_msg": _msg, "_name": _name, "_return": _return})

directive log{when: Hook::Enter, on: Target::Function, msg: Text, topic: Text}
    _log_publish!(_log_tag(LogLevel::Info), format!{"_msg": _msg, "_name": _name, "_args": _args}, _topic)

directive log{when: Hook::Exit, on: Target::Function, msg: Text, topic: Text}
    _log_publish!(_log_tag(LogLevel::Info), format!{"_msg": _msg, "_name": _name, "_return": _return}, _topic)

# ── log para Funções: com file ──
# file: write direto via write! (FFI), sem CSP.

directive log{when: Hook::Enter, on: Target::Function, msg: Text, file: File}
    write!(_file, format!{"_msg": _msg, "_name": _name, "_args": _args})

directive log{when: Hook::Exit, on: Target::Function, msg: Text, file: File}
    write!(_file, format!{"_msg": _msg, "_name": _name, "_return": _return})

directive log{when: Hook::Enter, on: Target::Function, msg: Text, topic: Text, file: File}
    _log_publish!(_log_tag(LogLevel::Info), format!{"_msg": _msg, "_name": _name, "_args": _args}, _topic)
    write!(_file, format!{"_msg": _msg, "_name": _name, "_args": _args})

directive log{when: Hook::Exit, on: Target::Function, msg: Text, topic: Text, file: File}
    _log_publish!(_log_tag(LogLevel::Info), format!{"_msg": _msg, "_name": _name, "_return": _return}, _topic)
    write!(_file, format!{"_msg": _msg, "_name": _name, "_return": _return})

# ── log com level: LogLevel — despacho por arg_key, level repassado direto ──
# level: LogLevel no dict serve para despacho por arg_keys.
# O body passa _level direto ao log!() — resolve_log_level aceita VariantQual.
# 8 overloads: 4 Actions (Enter/Exit × sem file/com file) + 4 Functions.

directive log{when: Hook::Enter, on: Target::Action, msg: Text, level: LogLevel}
    log!(_level, format!{"_msg": _msg, "_name": _name, "_args": _args})

directive log{when: Hook::Exit, on: Target::Action, msg: Text, level: LogLevel}
    log!(_level, format!{"_msg": _msg, "_name": _name, "_return": _return})

directive log{when: Hook::Enter, on: Target::Action, msg: Text, file: File, level: LogLevel}
    log!(_level, format!{"_msg": _msg, "_name": _name, "_args": _args}, _file)

directive log{when: Hook::Exit, on: Target::Action, msg: Text, file: File, level: LogLevel}
    log!(_level, format!{"_msg": _msg, "_name": _name, "_return": _return}, _file)

directive log{when: Hook::Enter, on: Target::Function, msg: Text, level: LogLevel}
    _log_publish!(_log_tag(_level), format!{"_msg": _msg, "_name": _name, "_args": _args})

directive log{when: Hook::Exit, on: Target::Function, msg: Text, level: LogLevel}
    _log_publish!(_log_tag(_level), format!{"_msg": _msg, "_name": _name, "_return": _return})

directive log{when: Hook::Enter, on: Target::Function, msg: Text, file: File, level: LogLevel}
    write!(_file, format!{"_msg": _msg, "_name": _name, "_args": _args})

directive log{when: Hook::Exit, on: Target::Function, msg: Text, file: File, level: LogLevel}
    write!(_file, format!{"_msg": _msg, "_name": _name, "_return": _return})