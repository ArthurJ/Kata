# Complex — exemplo canônico de tipo numérico implementado em Kata puro.
# Demonstra que a infraestrutura de interfaces (Fases 1-8) funciona end-to-end
# para um tipo definido pelo usuário sem FFI.

import core

data Complex (re::Float im::Float)

Complex implements NUM
    + :: Complex Complex => Complex
    lambda a b: Complex (+ a.re b.re) (+ a.im b.im)
    + :: Complex Int => Complex
    lambda a b: Complex (+ a.re (float b)) a.im
    - :: Complex Complex => Complex
    lambda a b: Complex (- a.re b.re) (- a.im b.im)
    * :: Complex Complex => Complex
    lambda a b: Complex (- (* a.re b.re) (* a.im b.im)) (+ (* a.re b.im) (* a.im b.re))
    div :: Complex Complex => Result::(Complex, Text)
    lambda a b:
        = denom 0.0: core.Result::Err "divisão por zero"
        otherwise: core.Result::Ok (Complex (div nr denom | 0.0) (div ni denom | 0.0))
        with
            denom := + (* b.re b.re) (* b.im b.im)
            nr := + (* a.re b.re) (* a.im b.im)
            ni := - (* a.im b.re) (* a.re b.im)

Complex implements EQ
    = :: Complex Complex => Boolean
    lambda a b: and (= a.re b.re) (= a.im b.im)
    != :: Complex Complex => Boolean
    lambda a b: not (= a b)

Complex implements SHOW
    show :: Complex => Text
    lambda a: + "(" (+ (show a.re) (+ " + " (+ (show a.im) "i)")))

# int: Complex → Int (trunca parte real)
int :: Complex => Int
lambda z: int z.re

# complex: Float → Complex (construtor com im=0)
complex :: Float => Complex
lambda f: Complex f 0.0

# complex: Int → Complex (construtor com im=0)
complex :: Int => Complex
lambda n: Complex (float n) 0.0
