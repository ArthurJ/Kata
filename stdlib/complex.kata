# Complex — exemplo canônico de tipo numérico implementado em Kata puro.
# Demonstra que a infraestrutura de interfaces funciona end-to-end
# para um tipo definido pelo usuário sem FFI.
#
# Complex é paramétrico em T (onde T implementa SCALAR), permitindo
# Complex::(Int, Int), Complex::(Float, Float), Complex::(Rational, Rational).
# Overloads de RING/EQ/SHOW são monomórficos para Complex::(Float, Float)
# pois usam operações Float-specific (sqrt, 0.0, float).
# Construtor é genérico — Complex 3 4 produz Complex::(Int).

import core

data Complex (re::T im::T) where T implements SCALAR

Complex::(Float, Float) implements RING
    + :: Complex::(Float, Float) Complex::(Float, Float) => Complex::(Float, Float)
    lambda a b: Complex (+ a.re b.re) (+ a.im b.im)
    @commutative
    + :: Complex::(Float, Float) Int => Complex::(Float, Float)
    lambda a b: Complex (+ a.re (float b)) a.im
    - :: Complex::(Float, Float) Complex::(Float, Float) => Complex::(Float, Float)
    lambda a b: Complex (- a.re b.re) (- a.im b.im)
    * :: Complex::(Float, Float) Complex::(Float, Float) => Complex::(Float, Float)
    lambda a b: Complex (- (* a.re b.re) (* a.im b.im)) (+ (* a.re b.im) (* a.im b.re))

    @commutative
    * :: Complex::(Float, Float) Int => Complex::(Float, Float)
    lambda a b: Complex (* a.re (float b)) (* a.im (float b))

    @commutative
    * :: Complex::(Float, Float) Float => Complex::(Float, Float)
    lambda a b: Complex (* a.re b) (* a.im b)

    - :: Complex::(Float, Float) Int => Complex::(Float, Float)
    lambda a b: Complex (- a.re (float b)) a.im

    - :: Complex::(Float, Float) Float => Complex::(Float, Float)
    lambda a b: Complex (- a.re b) a.im

    @commutative
    + :: Complex::(Float, Float) Float => Complex::(Float, Float)
    lambda a b: Complex (+ a.re b) a.im

    div :: Complex::(Float, Float) Complex::(Float, Float) => Result::(Complex::(Float, Float), Text)
    lambda a b:
        = denom 0.0: core.Result::Err "divisão por zero"
        otherwise: core.Result::Ok (Complex (div nr denom | 0.0) (div ni denom | 0.0))
        with
            denom := + (* b.re b.re) (* b.im b.im)
            nr := + (* a.re b.re) (* a.im b.im)
            ni := - (* a.im b.re) (* a.re b.im)

    zero :: Complex::(Float, Float) => Complex::(Float, Float)
    lambda _: Complex 0.0 0.0

    abs :: Complex::(Float, Float) => Complex::(Float, Float)
    lambda a: Complex (sqrt (+ (* a.re a.re) (* a.im a.im))) 0.0

Complex::(Float, Float) implements EQ
    = :: Complex::(Float, Float) Complex::(Float, Float) => Boolean
    lambda a b: and (= a.re b.re) (= a.im b.im)
    != :: Complex::(Float, Float) Complex::(Float, Float) => Boolean
    lambda a b: not (= a b)

Complex::(Float, Float) implements SHOW
    show :: Complex::(Float, Float) => Text
    lambda a: + "(" (+ (show a.re) (+ " + " (+ (show a.im) "i)")))

# int: Complex::(Float, Float) → Int (trunca parte real)
int :: Complex::(Float, Float) => Int
lambda z: int z.re

# complex: Float → Complex (construtor com im=0)
complex :: Float => Complex
lambda f: Complex f 0.0

# complex: Int → Complex (construtor com im=0)
complex :: Int => Complex
lambda n: Complex (float n) 0.0