fizzbuzz :: Int => Text
lambda x:
    both: "FizzBuzz"
    fizz: "Fizz"
    buzz: "Buzz"
    otherwise: show x
    with
        fizz := divisible x 3
        buzz := divisible x 5
        both := and fizz buzz

# Verifica se x é divisível por n usando div (retorna Result).
# div x n verifica = n 0 primeiro, mas n é literal não-zero.
# Se n = 0, div retorna Err — mas chamamos com literais 3 e 5.
# O resto da divisão é x - n * (x / n). Se resto = 0, é divisível.
divisible :: Int Int => Boolean
lambda x n:
    match div x n
        Ok q: = x (* n q)
        Err _: Boolean::False

action main
    echo!(fizzbuzz 3)
    echo!(fizzbuzz 5)
    echo!(fizzbuzz 15)
    echo!(fizzbuzz 7)
    echo!(fizzbuzz 2)

main!()