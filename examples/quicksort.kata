import stdio
# TODO deveria ser "stdio.(stdout)" para o stdout ficar disponivel no escopo do módulo
#da maneira como está, o acesso deveria ser restrito com stdio.stdout

# o file deveria ser "file", e o valor deveria ser stdout, sem a chamada "!()", afinal, o que o stdout está "fazendo" nesta situação?
@log{msg: "{_return}\n", when: "exit", file:stdout!()}
quicksort :: [Int] => [Int]
lambda []: []
lambda [pivo:resto]:
    + (quicksort menores) [pivo : (quicksort maiores)]
    with
        menores := filter (< _ pivo) resto
        maiores := filter (>= _ pivo) resto

action main
    let nums := [5 2 9 1 5 6 12 -1]
    let ordenado := quicksort nums
    echo!("Ordenacao Concluida")
    echo!(ordenado)

main!()