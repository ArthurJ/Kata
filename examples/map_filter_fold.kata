# map/filter/fold — higher-order functions sobre List::Int.
# Exercita os três builtins interceptados pelo codegen (core.kata).

# Helper: resto da divisão por 2.
# div x 2 retorna Result::(Int, Text); o operador | (fallback)
# desempacota o Ok (Int) e fornece 0 no caso Err (inalcançável: 2 ≠ 0).
# resto = x - 2 * (x / 2).
resto2 :: Int => Int
lambda x: - x (* 2 (div x 2 | 0))

action main
    let numeros := [1 2 3 4 5]

    echo!("--- map: multiplicar por 2 ---")
    let dobro := map (* _ 2) numeros
    for x in dobro
        echo!(x)

    echo!("--- filter: elementos pares ---")
    let pares := filter (lambda x: = 0 (resto2 x)) numeros
    for x in pares
        echo!(x)

    echo!("--- fold: soma acumulada ---")
    let soma := fold (+ _ _) 0 numeros
    echo!(soma)

    echo!("--- map com lista ---")
    let triplos := map (* _ 3) [1 2 3]
    for x in triplos
        echo!(x)

    echo!("fim")

main!()