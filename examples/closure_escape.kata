# Closure escape — closure capturando variável do escopo e escapando via let.
# Tipo de função como valor: (Int -> Int). A closure escapa via return (heap/ARC).
# Hole syntax (+ _ n) cria closure que captura n. O escape funciona quando
# a closure é criada em escopo local (let), não via return de função nomeada.

# Closure captura variável local e é chamada depois
let n := 5
let add5 := + _ n
let a := add5 3
echo!(a)

# Outro closure com captura diferente
let m := 10
let add10 := + _ m
let b := add10 7
echo!(b)

0