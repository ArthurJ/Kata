# Closure escape — closure capturando variável do escopo e escapando via return.
# Tipo de função como valor: (Int -> Int). A closure escapa via return (heap/ARC).
# Named function captura constant do escopo do módulo.

# Named function que captura constant n
make_adder :: Int => (Int -> Int)
lambda n: lambda x: + x n

constant add5 := make_adder 5
constant a := add5 3
echo!(a)

# Outro closure com captura diferente
constant add10 := make_adder 10
constant b := add10 7
echo!(b)

0