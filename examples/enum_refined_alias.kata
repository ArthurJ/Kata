# Enum Predicado + Alias de Refined + refines + ? + downcast
# Migração de test_imc.kata (legacy)

data (Float, > _ 0.0) as PositiveFloat

PositiveFloat refines NUM

alias PositiveFloat as Peso
alias PositiveFloat as Altura

# Enum predicado — smart constructor despacha por guards
enum IMC
    Magreza(< _ 18.5)
    Normal(<= _ 25.0)
    Sobrepeso(<= _ 30.0)
    Obesidade

# classificador_imc — recebe Peso e Altura (aliases de PositiveFloat).
# * é método de NUM → refines fallback despacha sem downcast (Peso→Float).
# / não é método de NUM (só div é) → downcast explícito necessário.
classificador_imc :: Peso Altura => IMC
lambda p a:
    IMC (/ (p::Float) (* a a))

# Bloco 1 — Construtores falíveis (alias de refined) + enum predicado
action bloco1 => Unit
    let p := Peso 70.0?
    let a := Altura 1.75?
    let imc := classificador_imc p a
    echo!(imc)

# Bloco 2 — ? em Action que pode falhar
action bloco2 => Result::(IMC, Text)
    let p := Peso 70.0?
    let a := Altura 1.75?
    Result::Ok (classificador_imc p a)

# Bloco 3 — Downcast encadeado alias→base (Peso → PositiveFloat → Float)
action bloco3 => Unit
    let p := Peso 70.0?
    let f := p::Float
    echo!(f)

# Bloco 4 — refines fallback: * despacha sem downcast
action bloco4 => Unit
    let a := Altura 1.75?
    let r := * a a
    echo!(r)

action main => Unit
    bloco1!()
    match (bloco2!())
        Ok v: echo!(v)
        Err _: echo!("erro")
        otherwise: echo!("impossivel")
    bloco3!()
    bloco4!()

main!()