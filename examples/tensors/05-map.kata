# Tensor — map (aplicação element-wise de função)
# map preserva shape e pode mudar o tipo do elemento (Int → Float).
# Condicionais dentro de lambda usam match (Kata não tem if).

action main
    let m := [1 2 3; 4 5 6]       # Tensor::Int 2×3

    echo!("--- map: quadrar cada elemento (Int → Int) ---")
    let sq := map (lambda x: * x x) m
    echo!(sq)

    echo!("--- map: somar 1 a cada elemento ---")
    let inc := map (lambda x: + x 1) m
    echo!(inc)

    echo!("--- map: multiplicar por 2 ---")
    let dbl := map (lambda x: * x 2) m
    echo!(dbl)

    echo!("--- map Float → Float: dobrar ---")
    let f := [1.5 2.5; 3.5 4.5]
    let fd := map (lambda x: * x 2.0) f
    echo!(fd)

    echo!("--- map sobre 1-D ---")
    let v := [1 2 3;]
    let vd := map (lambda x: * x 2) v
    echo!(vd)

main!()