action produtor (tx::Sender::Unit) => Unit
    sleep!(100)
    tx !> ()

action consumidor (rx::Receiver::Unit) => Unit
    select
        rx <! valor: echo!("Falha! Recebeu valor rapido demais")
        timeout 50: echo!("Sucesso! Timeout funcionou antes do produtor enviar")

    select
        rx <! valor: echo!("Sucesso! Recebeu o valor do produtor")
        timeout 500: echo!("Falha! Deu timeout mas o produtor deveria ter enviado")

action main => Unit
    let (tx, rx) := queue!(2)
    fork!(produtor, (tx))
    fork!(consumidor, (rx))
    sleep!(1000)

main!()