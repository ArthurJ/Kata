# Telemetria — @log (diretiva) + log!() (action nativa) + log_recv!() (consumo).
# @log injeta publicação no wrapping (prólogo se when: "enter", epílogo se when: "exit").
# log!() dispara na linha. log_recv!("topic") bloqueia até chegar mensagem.

# @log no prólogo: loga params na entrada (topic default, policy drop)
# _args é a tupla de params (41,) — repr inclém parênteses e vírgula
@log{msg: "entrada {_args}", when: "enter"}
action processar (x::Int) => Int
    + x 1

# @log no epílogo: loga o valor retornado na saída (topic metrics, policy block)
# _return é o valor retornado (Int 42) — repr sem parênteses
@log{msg: "resultado {_return}", when: "exit", topic: "metrics", policy: "block"}
action dobrar (x::Int) => Int
    let r := * x 2
    r

# log!() — publicação explícita no corpo (mensagem dinâmica, sem template)
action anunciar => Unit
    log!(LogLevel::Warn, "evento-manual", "events")
    ()

# Consumidor: log_recv!() retorna Result(Text, Text) — Ok(msg) ou Err(reason)
action consumir => Int
    match log_recv!("default")
        Result::Ok m1: echo!(m1)
        Result::Err _: echo!("erro: tópico default não encontrado")
    match log_recv!("metrics")
        Result::Ok m2: echo!(m2)
        Result::Err _: echo!("erro: tópico metrics não encontrado")
    match log_recv!("events")
        Result::Ok m3: echo!(m3)
        Result::Err _: echo!("erro: tópico events não encontrado")
    0

action main => Int
    # Fork produtores e consumidor em fibers separadas
    fork!(processar, (41))
    fork!(dobrar, (21))
    fork!(anunciar, ())
    fork!(consumir, ())
    sleep!(50)
    0

main!()