# Probe H: guards ESPALHADOS por cláusulas com o MESMO pattern.
# Cláusula 1: Some x com guard > x 0 (sem otherwise).
# Cláusula 2: Some x com guard <= x 0.
# Cláusula 3: None.
# A função é TOTAL (toda entrada produz valor), mas cada cláusula
# individualmente NÃO é tautológica. Hoje: per-cláusula exige otherwise.

foo :: Optional::(Int) => Text
lambda Optional::Some x:
    > x 0: "positivo"
lambda Optional::Some x:
    <= x 0: "zero ou negativo"
lambda Optional::None:
    "nada"

action main
    echo!(foo (Some 5))
    echo!(foo (Some (- 0 5)))

main!()